# Required
NODE_ENV=production
PORT=3000
BASE_URL=https://YOUR-RENDER-DOMAIN.onrender.com
# Generate a random 32+ character secret (do not commit a real secret)
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
# OpenAI Platform API key with image generation billing enabled
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
FREE_CREDITS=1
# Paddle: use sandbox values until end-to-end tests pass
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_STUDIO=
# Google-only sign-in; callback must be BASE_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Render persistent disk mount path (set DATA_DIR to its mount path)
DATA_DIR=./data
